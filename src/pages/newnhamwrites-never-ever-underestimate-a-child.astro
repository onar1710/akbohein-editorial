<Layout
	title={`${title} | Akboheim`}
	description="“Never underestimate a child,” says Griselda Heppel. They lap up anything and everything when it comes to a feast of good versus evil."
	canonical={canonical}
	author="Amna Boheim"
>
	<main class="article-page">
		<div class="article-container">
