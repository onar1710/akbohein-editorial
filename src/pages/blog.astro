---
import Layout from '../layouts/Layout.astro';
const entries = [
	{
		title: 'Email to Dina Powell, Senior Advisor to Trump.',
		description:
			'This is an email I sent to Dina Powell, a partner at my former firm, Goldman Sachs, who recently joined the Trump Administration as Senior Advisor.',
		href: '/email-to-dina-powell-senior-advisor-to-trump/',
	},
	{
		title: 'NewnhamWrites … Rules? There are no rules',
		description:
			'Rules? There are no rules. Award-winning author and Newnhamite (NC 2000), Jenn Ashworth on her writing life, her time at Newnham and why she hated school.',
		href: '/newnhamwrites-rules-there-are-no-rules/',
	},
	{
		title: "Mama, there’s a monster under my bed…",
		description:
			'My Better Half has been trying to persuade me to see The Babadook… and my three-year-old daughter has recently discovered monsters hiding in her room.',
		href: '/mama-theres-a-monster-under-my-bed/',
	},
	{
		title: 'NewnhamWrites … Never ever underestimate a child',
		description:
			'“Never underestimate a child,” says Griselda Heppel. “They lap up anything and everything when it comes to a feast of good versus evil…”',
		href: '/newnhamwrites-never-ever-underestimate-a-child/',
	},
	{
		title: 'Farewell London – The Sequel (Or, Life in the Boonies)',
		description:
			'Four weeks ago we moved from London to the ‘burbs. While it’s a far cry from London, it’s All Good. There are, however, a few things which we’re getting used to…',
		href: '/farewell-london-the-sequel-or-life-in-the-boonies/',
	},
];
---
<Layout
	title="Blog | Akboheim"
	description="Blog: republished articles to recover expired-domain URLs."
	canonical="https://akboheim.com/blog/"
>
	<header class="header">
		<h1>Blog</h1>
		<p class="intro">Republished articles to recover expired-domain URLs.</p>
	</header>
	<section class="grid">
		{entries.map((entry) => (
			<article class="card">
				<a class="card-link" href={entry.href} aria-label={entry.title}></a>
				<div class="card-content">
					<span class="title" aria-hidden="true">{entry.title}</span>
					{entry.description && <p class="desc">{entry.description}</p>}
					<div class="card-footer">
						<span class="read-more" aria-hidden="true">Read</span>
					</div>
				</div>
			</article>
		))}
	</section>
</Layout>
<style>
	.header {
		padding: 8px 0 16px;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	h1 {
		font-family: 'Playfair Display', 'Georgia', 'Times New Roman', serif;
		font-size: clamp(32px, 5vw, 48px);
		font-weight: 900;
		letter-spacing: -0.03em;
		margin: 0 0 10px;
		color: #1a1a1a;
	}

	.intro {
		margin: 0;
		max-width: 720px;
		padding: 0 16px;
		color: rgba(0, 0, 0, 0.72);
		font-size: 16px;
		line-height: 1.6;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(1, minmax(0, 1fr));
		gap: 12px;
		padding: 0 24px;
	}

	.card {
		position: relative;
		background: white;
		border: 1px solid rgba(0, 0, 0, 0.08);
		border-radius: 16px;
		overflow: hidden;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		cursor: pointer;
	}

	.card-link {
		position: absolute;
		inset: 0;
		z-index: 10;
		display: block;
		border-radius: 16px;
	}

	.card-link:focus-visible {
		outline: 3px solid rgba(139, 0, 0, 0.55);
		outline-offset: 2px;
		border-radius: 16px;
	}

	.card:hover {
		transform: translateY(-4px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
	}

	.card-content {
		position: relative;
		z-index: 1;
		pointer-events: none;
		padding: 16px;
	}

	.title {
		text-decoration: none;
		color: #1a1a1a;
		font-weight: 700;
		font-size: 18px;
		font-family: 'Playfair Display', Georgia, serif;
		display: block;
		margin-bottom: 8px;
		line-height: 1.3;
	}

	.desc {
		margin: 8px 0;
		color: rgba(0, 0, 0, 0.72);
		font-size: 14px;
		line-height: 1.5;
	}

	.card-footer {
		display: flex;
		justify-content: flex-end;
		margin-top: 14px;
		padding-top: 12px;
		border-top: 1px solid rgba(0, 0, 0, 0.06);
	}

	.read-more {
		font-family: 'Inter', sans-serif;
		font-size: 13px;
		font-weight: 800;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: #8b0000;
		white-space: nowrap;
	}

	@media (min-width: 860px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1100px) {
		.grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
